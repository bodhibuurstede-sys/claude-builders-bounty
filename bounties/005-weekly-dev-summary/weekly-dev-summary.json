        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1200, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a9999999-9999-4999-8999-999999999999",
      "name": "Generate summary with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nconst text = Array.isArray(body.content)\n  ? body.content.filter(part => part.type === 'text').map(part => part.text).join('\\n')\n  : '';\nif (!text.trim()) throw new Error('Claude response contained no text');\nreturn [{ json: { content: text.trim() } }];"
      },
      "id": "abbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "name": "Extract summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        20
      ]
    },
