        -1040,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg1",
              "name": "githubRepo",
              "value": "={{ $env.GITHUB_REPO || 'n8n-io/n8n' }}",
              "type": "string"
            },
            {
              "id": "cfg2",
              "name": "language",
              "value": "={{ ($env.SUMMARY_LANGUAGE || 'EN').toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "cfg3",
              "name": "githubApiBaseUrl",
              "value": "={{ $env.GITHUB_API_BASE_URL || 'https://api.github.com' }}",
              "type": "string"
            },
            {
              "id": "cfg4",
              "name": "anthropicApiBaseUrl",
              "value": "={{ $env.ANTHROPIC_API_BASE_URL || 'https://api.anthropic.com' }}",
              "type": "string"
            },
            {
              "id": "cfg5",
              "name": "destinationWebhookUrl",
              "value": "={{ $env.DESTINATION_WEBHOOK_URL }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -800,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $json;\nif (!cfg.githubRepo || !cfg.githubRepo.includes('/')) {\n  throw new Error('GITHUB_REPO must be owner/repo');\n}\nif (!['EN', 'FR'].includes(cfg.language)) {\n  throw new Error('SUMMARY_LANGUAGE must be EN or FR');\n}\nif (!cfg.destinationWebhookUrl) {\n  throw new Error('DESTINATION_WEBHOOK_URL is required');\n}\nconst [owner, repo] = cfg.githubRepo.split('/');\nconst until = new Date();\nconst since = new Date(until.getTime() - 7 * 24 * 60 * 60 * 1000);\nreturn [{\n  json: {\n    ...cfg,\n    owner,\n    repo,\n    since: since.toISOString(),\n    until: until.toISOString(),\n    sinceDate: since.toISOString().slice(0, 10),\n    untilDate: until.toISOString().slice(0, 10)\n  }\n}];"
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Build date range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        20
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.githubApiBaseUrl + '/repos/' + $json.owner + '/' + $json.repo + '/commits' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "until",
              "value": "={{ $json.until }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "Fetch commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -300,
        20
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.githubApiBaseUrl + '/search/issues' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'repo:' + $('Build date range').first().json.githubRepo + ' is:issue is:closed closed:' + $('Build date range').first().json.sinceDate + '..' + $('Build date range').first().json.untilDate }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a6666666-6666-4666-8666-666666666666",
      "name": "Fetch closed issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        20
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.githubApiBaseUrl + '/search/issues' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'repo:' + $('Build date range').first().json.githubRepo + ' is:pr is:merged merged:' + $('Build date range').first().json.sinceDate + '..' + $('Build date range').first().json.untilDate }}"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GITHUB_TOKEN }}"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a7777777-7777-4777-8777-777777777777",
      "name": "Fetch merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const unwrap = (items) => items.flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]);\nconst commits = unwrap($('Fetch commits').all());\nconst closedResponse = $('Fetch closed issues').first().json;\nconst mergedResponse = $('Fetch merged PRs').first().json;\nconst issues = Array.isArray(closedResponse) ? closedResponse : (closedResponse.items || []);\nconst prs = Array.isArray(mergedResponse) ? mergedResponse : (mergedResponse.items || []);\nconst range = $('Build date range').first().json;\n\nconst commitLines = commits.slice(0, 50).map(c =>\n  `- ${(c.sha || '').slice(0, 7)} ${(c.commit?.message || c.message || '').split('\\n')[0]}`\n);\nconst issueLines = issues.slice(0, 50).map(i => `- #${i.number}: ${i.title}`);\nconst prLines = prs.slice(0, 50).map(p => `- #${p.number}: ${p.title}`);\n\nconst languageInstruction = range.language === 'FR'\n  ? 'Write the final narrative in French.'\n  : 'Write the final narrative in English.';\n\nconst prompt = `You are writing a concise weekly engineering update for ${range.githubRepo}.\nPeriod: ${range.sinceDate} through ${range.untilDate}.\n${languageInstruction}\n\nUse only the activity below. Do not invent work. Mention meaningful themes, shipped changes, fixes, and notable maintenance. Avoid a raw list; synthesize a narrative with:\n1. Highlights\n2. What changed\n3. Issues resolved\n4. What to watch next (only if inferable from the supplied data)\n\nCOMMITS (${commits.length})\n${commitLines.join('\\n') || '- none'}\n\nCLOSED ISSUES (${issues.length})\n${issueLines.join('\\n') || '- none'}\n\nMERGED PRS (${prs.length})\n${prLines.join('\\n') || '- none'}`;\n\nreturn [{ json: { prompt, repo: range.githubRepo, language: range.language } }];"
      },
      "id": "a8888888-8888-4888-8888-888888888888",
      "name": "Build Claude prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
